# 复制为 sit-secrets.yaml（已 gitignore），或设环境变量 PRO_API_TOKEN
# 直连本机 RCS 时，把浏览器里的 token 贴在 auth.default.token
auth:
  default:
    token: ""
# 多档案示例（按需打开）：
#   环境变量等价写法：PRO_API_AUTH_PORTAL_TOKEN / PRO_API_AUTH_OPENAPI_APIKEY
# auth:
#   portal:
#     token: "浏览器复制的 Nebula token"
#   openapi:
#     apiKey: "第三方 apiKey"
